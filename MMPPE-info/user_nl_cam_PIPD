!-------------------------------------------------------------------------------
! History tapes:
!   h0 (tape 1) -- 6-hourly instantaneous, MMPPE.md mandatory 6-hourly table
!   h1 (tape 2) -- 6-hourly instantaneous, MMPPE.md "(optional)" MODIS/COSP
!                  table -- requires COSP built with the MODIS simulator on
!   h2 (tape 3) -- monthly mean = "all 6h outputs except cosp" (i.e. h0's
!                  fields, plus the non-cosp fields from h1's table, all
!                  re-requested here at monthly-average frequency) PLUS the
!                  Monthly Mean table's additional variables
!
! nhtfrq < 0 means "hours between samples"; nhtfrq = 0 means "monthly avg".
! mfilt values below chunk output into manageable per-file sizes for a
! 1-year run (4 samples/day for h0/h1 -> 120 = 30 days/file; h2 is already
! monthly -> 12 = 1 file/year). Adjust to taste/storage constraints.
!-------------------------------------------------------------------------------
nhtfrq(1) = -6
mfilt(1)  = 120

nhtfrq(2) = -6
mfilt(2)  = 120

nhtfrq(3) = 0
mfilt(3)  = 12

!-------------------------------------------------------------------------------
! Diagnostic ("double-call") radiation configuration for the aerosol-free TOA
! flux fields (rsut_na, rsutcs_na, rlut_na, rlutcs_na). rad_diag_1 defines a
! SECOND radiation call using only this species list -- with every aerosol
! mode entry omitted, the call sees no aerosol at all, and CAM appends a
! "_d1" suffix to every field from that call (FSUTOA_d1, FSUTOAC_d1, FLUT_d1,
! FLUTC_d1 -- see src/physics/cam/rad_constituents.F90 and
! src/physics/rrtmg/radiation.F90's diag(0:N_DIAG) array).
!
! Gas list below is the non-aerosol portion of test/system/nl_files/
! rad_diag_mam's rad_diag_1 (a working example already in this repo's test
! suite) -- gases are independent of the aerosol/mode scheme, so this should
! carry over from that MAM3 test to this branch's MAM4 configuration
! unchanged. CAVEAT: not yet cross-checked against this specific case's
! resolved default rad_climate (e.g. whether stratospheric volcanic aerosol
! feedback or an extra trace gas is active would add an entry there) --
! recommend a one-time `case.setup` + inspecting CaseDocs/atm_in's rad_climate
! value before a real run, to confirm no gas is missing here.
!-------------------------------------------------------------------------------
rad_diag_1 = 'A:Q:H2O', 'N:O2:O2', 'N:CO2:CO2', 'N:ozone:O3', 'N:N2O:N2O',
   'N:CH4:CH4', 'N:CFC11:CFC11', 'N:CFC12:CFC12'

